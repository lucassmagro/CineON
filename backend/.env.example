DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/cineon?schema=public"

# em produção use um valor longo e aleatório (openssl rand -hex 32)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_MINUTOS=120

PORT=3000

# minutos que o cliente tem pra pagar a reserva
RESERVA_MINUTOS=10
# quanto tempo antes do início a entrada é liberada
VALIDACAO_ANTECEDENCIA_MIN=60
CANCELAMENTO_ANTECEDENCIA_MIN=30
LIMPEZA_SALA_MIN=15

# separadas por vírgula; vazio libera qualquer origem
CORS_ORIGENS=

DB_POOL_MAX=10
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=300000
