@startuml CineON - Casos de Uso
' dá pra gerar a imagem com a extensão PlantUML do VS Code
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Visitante" as Visitante
actor "Cliente" as Cliente
actor "Operador\n(Bilheteria)" as Bilheteria
actor "Operador\n(Gerência)" as Gerencia
actor "Sistema\n(relógio)" as Sistema

Cliente -|> Visitante

rectangle "CineON" {
  usecase "UC01 Cadastrar-se" as UC01
  usecase "UC02 Fazer login" as UC02
  usecase "UC03 Ver filmes em cartaz\ne sessões" as UC03
  usecase "UC04 Ver mapa de assentos" as UC04
  usecase "UC05 Reservar assentos\n(reserva temporária)" as UC05
  usecase "UC06 Pagar reserva\n(simulado)" as UC06
  usecase "UC07 Emitir ingressos\ncom código único" as UC07
  usecase "UC08 Ver meus ingressos" as UC08
  usecase "UC09 Desistir da reserva" as UC09
  usecase "UC10 Vender no balcão" as UC10
  usecase "UC11 Validar ingresso\nna entrada" as UC11
  usecase "UC12 Manter filmes" as UC12
  usecase "UC13 Manter salas\n(gera assentos)" as UC13
  usecase "UC14 Manter sessões" as UC14
  usecase "UC15 Relatório de vendas\ne ocupação" as UC15
  usecase "UC16 Cadastrar operador" as UC16
  usecase "UC17 Expirar reservas\nvencidas" as UC17
  usecase "UC18 Cancelar\ningressos" as UC18
}

Visitante --> UC01
Visitante --> UC02
Visitante --> UC03
Visitante --> UC04

Cliente --> UC05
Cliente --> UC06
Cliente --> UC08
Cliente --> UC09
UC06 ..> UC07 : <<include>>
UC05 ..> UC04 : <<include>>

Bilheteria --> UC10
Bilheteria --> UC11
UC10 ..> UC05 : <<include>>
UC10 ..> UC06 : <<include>>

Gerencia --> UC12
Gerencia --> UC13
Gerencia --> UC14
Gerencia --> UC15
Gerencia --> UC16

Sistema --> UC17
Cliente --> UC18
@enduml
